{
  "name": "material-readiness-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src && vitest run --dir scripts",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "check:browser-files": "node scripts/check-browser-files.ts",
    "seed": "node scripts/seed.ts",
    "test:seed": "vitest run --dir tests/seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "supabase": "3.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
